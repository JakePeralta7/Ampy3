# Database
DATABASE_URL=postgresql://ampy3:ampy3@postgres:5432/ampy3

# Auth (Plex SSO)
REQUIRE_AUTH=false
APP_URL=http://localhost:8000
SECRET_KEY=
SESSION_TTL_HOURS=168

# Celery / Valkey
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
CELERY_WORKER_CONCURRENCY=4

# Ollama (external deployment)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e4b-128:latest
OLLAMA_TIMEOUT=120

# Application environment flag
APP_ENV=development
DEBUG=True