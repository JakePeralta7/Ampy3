# Database
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Auth (Plex SSO)
# REQUIRE_AUTH defaults to true. Set to false ONLY for trusted local networks
# without internet exposure — with it off the API is unauthenticated and CORS
# is wide open.
REQUIRE_AUTH=true
APP_URL=http://localhost:8000
PLEX_CLIENT_ID=
# Required (>=32 chars) — the app refuses to start with REQUIRE_AUTH=true or
# APP_ENV=production without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_TTL_HOURS=168

# Celery / Valkey
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_LOG_LEVEL=info

# Logging (json | console), shared by API and worker
LOG_FORMAT=json

# Application environment flag
# IMPORTANT: Set to "production" in production deployments.
# When APP_ENV=production, the app requires SECRET_KEY (>=32 chars) and enforces
# secure cookies (Secure flag). When REQUIRE_AUTH=true, SECRET_KEY is also required.
# For local development without Docker, leave unset or use "development".
APP_ENV=production
DEBUG=False

# YouTube Music
YT_DLP_TIMEOUT=300

# Caching
SOURCE_PLAYLIST_CACHE_TTL_SECONDS=300
EXPLORE_CACHE_TTL_SECONDS=900

# HTTP port + bind (used by docker compose for the web service)
# The API binds to 127.0.0.1 by default so it is NOT reachable from the network.
# To expose it (e.g. a home server on your LAN), set APP_BIND=0.0.0.0.
APP_PORT=8000
APP_BIND=127.0.0.1